# ─────────────────────────────────────────────────────────────────────────────
#  Postiz – deine persönlichen Einstellungen
#
#  NICHT von Hand kopieren: ./setup.sh legt daraus automatisch die Datei .env an
#  und füllt alle Passwörter mit sicheren Zufallswerten.
#  Die .env NIEMALS auf GitHub hochladen (sie steht deshalb in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Adresse ──────────────────────────────────────────────────────────────────
# Auf deinem eigenen Rechner:          POSTIZ_URL=http://localhost:4007
# Auf einem Server mit eigener Domain: POSTIZ_URL=https://social.deine-domain.de
POSTIZ_URL=http://localhost:4007
# Nur für Server-Betrieb mit HTTPS (Profil "https"): die Domain ohne https://
POSTIZ_DOMAIN=
# Nur für Laptop-Betrieb über Cloudflare-Tunnel (./setup.sh --tunnel <domain> fragt danach).
# Geheim halten – wer das Token hat, kann den Tunnel übernehmen.
CLOUDFLARE_TUNNEL_TOKEN=
# Nur auf dem eigenen Rechner ohne HTTPS nötig (Login-Cookie ohne https erlauben).
# Auf dem Server mit HTTPS unbedingt LEER lassen.
NOT_SECURED=true
# 127.0.0.1 = nur von diesem Rechner erreichbar (sicher). Nicht ändern.
POSTIZ_BIND=127.0.0.1
# Feste, getestete Version = keine Überraschungen. Neuere holen: ./update.sh (ANLEITUNG.md, Kapitel 8)
POSTIZ_VERSION=v2.24.0
# Zeitzone für Server-Protokolle
TZ=Europe/Berlin

# ── Sicherheit (setup.sh füllt das automatisch) ─────────────────────────────
JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
TEMPORAL_DB_PASSWORD=CHANGE_ME
# true = niemand außer dir kann ein Konto anlegen (dein allererstes Konto geht immer)
DISABLE_REGISTRATION=true

# ── Automatisierung ─────────────────────────────────────────────────────────
# Wie viele Posts pro Stunde über die API/Skripte angelegt werden dürfen
API_LIMIT=60

# ── KI-Assistent in Postiz (optional) ───────────────────────────────────────
# Mit einem OpenAI-Schlüssel schreibt Postiz dir Post-Entwürfe & Bilder.
OPENAI_API_KEY=

# ── Social-Media-Zugänge ────────────────────────────────────────────────────
# Nur ausfüllen, was du wirklich nutzt. Wo du die Schlüssel bekommst:
# ANLEITUNG.md, Kapitel 4. Als Weiterleitungs-URL (Redirect/Callback) trägst du
# bei jeder Plattform ein:  <POSTIZ_URL>/integrations/social/<plattform>
#   z. B. https://social.deine-domain.de/integrations/social/instagram

# Facebook-Seite + Instagram (über Facebook-Business)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram direkt (ohne Facebook-Seite, "Instagram Standalone")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn (Profil + Unternehmensseite)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# X / Twitter
X_API_KEY=
X_API_SECRET=
# Mastodon (funktioniert ohne Genehmigung – gut zum Ausprobieren)
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
# Bluesky, Telegram, Discord u. a. brauchen keine Schlüssel hier –
# die verbindest du direkt in Postiz mit Benutzername/App-Passwort.

# ── E-Mail-Versand (optional, z. B. für "Passwort vergessen") ───────────────
# Kostenloser Resend-Account reicht: https://resend.com
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_NAME=Mentale Schonkost
EMAIL_FROM_ADDRESS=
